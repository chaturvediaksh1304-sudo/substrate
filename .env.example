# Required — app fails to start without it.
DATABASE_URL=postgresql+psycopg://substrate:substrate@db:5432/substrate

# Optional — higher Semantic Scholar rate limits. Unset is fine.
SEMANTIC_SCHOLAR_API_KEY=

# Required for POST /ask (synthesis). The app still boots without it —
# /health and /ingest keep working; only /ask fails, loudly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Which LLM answers: anthropic (default, needs the key above) or ollama (needs no key).
# With ollama, run `ollama serve` on the host and `ollama pull` the model below first.
LLM_PROVIDER=anthropic
# localhost is right when the API runs on the host. Inside the api container localhost is
# the container: docker-compose.yml already overrides this with host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Postgres container credentials (must match DATABASE_URL above).
POSTGRES_USER=substrate
POSTGRES_PASSWORD=substrate
POSTGRES_DB=substrate
